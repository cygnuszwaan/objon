+	draw_arc(Vector2.ZERO, 5.0, 0.0, TAU, 16, Color(COLOR_EDGE, 0.8), 1.0)
+	draw_circle(Vector2.ZERO, 3.5, Color(0.1, 0.11, 0.14))
