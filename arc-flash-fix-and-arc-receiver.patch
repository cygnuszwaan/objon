+		draw_arc(Vector2.ZERO, 7.0, -PI * 0.5, -PI * 0.5 + TAU * left, 24, COLOR_LENS_ON, 1.0)
+	if _flash_t > 0.0:
+		var t := 1.0 - _flash_t / FLASH_TIME
+		draw_arc(Vector2.ZERO, 4.0 + 4.0 * t, 0.0, TAU, 16, Color(COLOR_CORE, 1.0 - t), 1.5)
